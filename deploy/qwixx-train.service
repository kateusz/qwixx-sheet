[Unit]
Description=Qwixx AI weight training
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__NODE__ __ROOT__/node_modules/tsx/dist/cli.mjs __ROOT__/scripts/train-qwixx-ai.ts --hours 0 --games 32
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
