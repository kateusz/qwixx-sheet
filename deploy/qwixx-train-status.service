[Unit]
Description=Qwixx AI training status panel
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
Environment=QWIXX_ROOT=__ROOT__
Environment=QWIXX_STATUS_HOST=127.0.0.1
Environment=QWIXX_STATUS_PORT=8787
ExecStart=__NODE__ __ROOT__/scripts/qwixx-train-status.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
